# Keys only. Fill in any you have; blank ones are skipped.
# Which models each task uses (1st, 2nd, 3rd choice) is set in config.yaml (`tasks:`).
# To see which tasks can run with the keys you have: python teachme.py check

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# OpenAI (platform.openai.com)
OPENAI_API_KEY=

# OpenRouter (openrouter.ai): many providers behind one key
OPENROUTER_API_KEY=

# Google Gemini: FREE key at https://aistudio.google.com/apikey (no credit card).
# Also lets Gemini watch YouTube videos to check them against the lesson.
GEMINI_API_KEY=

# No keys at all? Install Ollama (https://ollama.com) and run "ollama pull qwen3:8b":
# a free model on your own computer (slower, simpler lessons). List it in config.yaml
# as ollama/auto (best installed) or e.g. ollama/qwen3:8b.
OLLAMA_URL=http://localhost:11434

# Required for the video modes (YouTube Data API v3).
YOUTUBE_API_KEY=

# Optional: key for a hosted text-to-speech endpoint (tts_engine: openai in config.yaml).
# Not needed for a local Kokoro server.
TTS_API_KEY=

# Web site (for a Cloudflare Tunnel). The site is on only when WEB_PASSWORD is set
# (4+ characters). It listens on 127.0.0.1 only; point the tunnel at
# http://localhost:8795. `npm run server` in electron/ runs it without the window;
# otherwise the desktop app serves it while open (not both at once).
WEB_PASSWORD=
WEB_PORT=8795

# Optional, for emailing course PDFs. Without these the app opens a new message
# in your mail program instead and you attach the PDF yourself.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an App Password
# (Google Account > Security > App passwords), not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional: where each new course's build report (models, sources, cost) is emailed.
REPORT_EMAIL=

